# OSCAR On-Site Static Network Worksheet (Hotel-Room Staging -> Site Cutover)
#
# 1. Copy this file to site-network.env:
#      cp ubuntu/site-network.example.env site-network.env
# 2. Run 'sudo bash oscar.sh identify-nics --watch' and plug/unplug a cable to find your Linux port names.
# 3. Fill in the values from your site schematic below.
#    - Accepts EITHER CIDR prefix (/24) OR dotted subnet mask (/255.255.255.0).
#    - Leave PRIMARY_GATEWAY and PRIMARY_DNS empty ("") if the site is completely offline with no router.
# 4. Stage in the hotel room (does NOT disconnect hotel Wi-Fi or hotel Ethernet DHCP!):
#      sudo bash oscar.sh stage-site-network --config site-network.env
# 5. Once physically on-site with cables connected, activate in one command:
#      sudo bash oscar.sh apply-site-network

# Port 1: Operator Workstation / Site LAN Ethernet Port
PRIMARY_NIC="enp1s0"
PRIMARY_IP_CIDR="198.51.100.10/24"
PRIMARY_GATEWAY="198.51.100.1"
PRIMARY_DNS=""

# Port 2 (Optional): Dedicated Isolated RPM & Camera Switch Port
# Leave SENSOR_NIC="" and SENSOR_IP_CIDR="" on single-NIC machines.
# Never assign a gateway to the sensor NIC (OSCAR omits it automatically so routing never breaks).
SENSOR_NIC="enp2s0"
SENSOR_IP_CIDR="203.0.113.10/24"

# Hostname operators will open in Chrome/Edge (https://oscar.local/)
OSCAR_SITE_HOSTNAME="oscar.local"
